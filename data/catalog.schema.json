{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"APIsr reviewed free API catalog",
  "type":"object",
  "required":["schema_version","title","checked_on","timezone","total_services","category_counts","free_type_counts","services"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "title":{"const":"APIsr"},
    "checked_on":{"type":"string","format":"date"},
    "timezone":{"type":"string"},
    "scope_ar":{"type":"string"},
    "total_services":{"type":"integer","minimum":1},
    "category_counts":{"type":"object","additionalProperties":{"type":"integer","minimum":1}},
    "free_type_counts":{"type":"object","additionalProperties":{"type":"integer","minimum":1}},
    "services":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/service"}}
  },
  "$defs":{
    "evidence":{
      "type":"object",
      "required":["url","kind","checked_on","method"],
      "properties":{
        "url":{"type":"string","format":"uri"},
        "kind":{"type":"string"},
        "checked_on":{"type":"string","format":"date"},
        "method":{"enum":["direct_https_read","web_reader"]},
        "http_status":{"type":"integer"},
        "retrieved_at":{"type":"string"},
        "content_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "note_ar":{"type":"string"}
      }
    },
    "service":{
      "type":"object",
      "required":["id","name","category","category_ar","auth","free_type","price_usd_within_free_scope","quota","reset","base_url","get_access_url","credit_card_required","commercial_use","limitations_ar","verification","private_credentials_included"],
      "properties":{
        "id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name":{"type":"string","minLength":1},
        "category":{"type":"string","minLength":1},
        "category_ar":{"type":"string","minLength":1},
        "auth":{"enum":["api_key","account_token","no_key","api_key_or_no_key","api_key_or_public_demo","username","public_demo_key"]},
        "free_type":{"enum":["recurring_quota","unmetered_public"]},
        "price_usd_within_free_scope":{"const":0},
        "quota":{"type":"string","minLength":1},
        "reset":{"type":"string","minLength":1},
        "base_url":{"type":"string","minLength":1},
        "get_access_url":{"type":"string","format":"uri"},
        "credit_card_required":{"type":["boolean","null"]},
        "credit_card_evidence":{"enum":["explicit_or_keyless","not_confirmed"]},
        "commercial_use":{"enum":["allowed","restricted","non_commercial","development_only","unknown"]},
        "limitations_ar":{"type":"string","minLength":1},
        "private_credentials_included":{"const":false},
        "official_public_demo_key":{"enum":["DEMO_KEY","1","helloworld"]},
        "discovered_from":{"type":"array","items":{"type":"string","format":"uri"}},
        "discovery_route":{"type":"string"},
        "verification":{
          "type":"object",
          "required":["status","checked_on","timezone","evidence","live_key_tested"],
          "properties":{
            "status":{"const":"official_documentation_reviewed"},
            "checked_on":{"type":"string","format":"date"},
            "timezone":{"type":"string"},
            "live_key_tested":{"type":"boolean"},
            "evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence"}}
          }
        }
      }
    }
  }
}
